###  http://purl.obolibrary.org/obo/CHEBI_176783
<http://purl.obolibrary.org/obo/CHEBI_176783> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_50523> ;
                                              <http://purl.obolibrary.org/obo/IAO_0000115> "Any member of a group of vitamers that belong to the chemical structural class called butenolides that exhibit biological activity against vitamin C deficiency in animals. The vitamers include <small>L</small>-ascorbic acid and its salt, ionized and oxidized forms." ;
                                              <http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> "CHEBI:21241" ;
                                              <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chebi_ontology" ;
