                                                             <http://purl.obolibrary.org/obo/CHEBI_38164> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_50996> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A morphinane alkaloid that is a highly potent opiate analgesic psychoactive drug. Morphine acts directly on the central nervous system (CNS) to relieve pain but has a high potential for addiction, with tolerance and both physical and psychological dependence developing rapidly. Morphine is the most abundant opiate found in <em>Papaver somniferum</em> (the opium poppy)." ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> "CHEBI:14622" ,
                                                                                                             "CHEBI:25419" ,
