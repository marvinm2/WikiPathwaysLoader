###  http://purl.obolibrary.org/obo/CHEBI_37537
<http://purl.obolibrary.org/obo/CHEBI_37537> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_139592> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_37532> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_47622> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_50860> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_51307> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_87691> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A phorbol ester that is phorbol in which the hydroxy groups at the cyclopropane ring juction (position 13) and the adjacent carbon (position 12) have been converted into the corresponding acetate and myristate esters. It is a major active constituent of the seed oil of <em>Croton tiglium</em>. It has been used as a tumour promoting agent for skin carcinogenesis in rodents and is associated with increased cell proliferation of malignant cells. However its function is controversial since a decrease in cell proliferation has also been observed in several cancer cell types." ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> "CHEBI:745" ,
                                                                                                             "CHEBI:746" ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chebi_ontology" ;
                                             <http://www.geneontology.org/formats/oboInOwl#id> "CHEBI:37537" ;
                                             <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/3_STAR> ;
                                             rdfs:label "phorbol 13-acetate 12-myristate" .


