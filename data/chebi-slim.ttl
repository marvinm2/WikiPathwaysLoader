###  http://purl.obolibrary.org/obo/CHEBI_233324
<http://purl.obolibrary.org/obo/CHEBI_233324> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_37622> ,
                                                              <http://purl.obolibrary.org/obo/CHEBI_38314> ,
                                                              <http://purl.obolibrary.org/obo/CHEBI_50860> ;
                                              <http://purl.obolibrary.org/obo/IAO_0000115> "Darovasertib is an orally available protein kinase C (PKC) inhibitor with potential immunosuppressive and antineoplastic activities. Upon oral administration, darovasertib inds to and inhibits PKC, which prevents the activation of PKC-mediated signaling pathways. This may lead to the induction of cell cycle arrest and apoptosis in susceptible tumor cells." ;
                                              <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chebi_ontology" ;
                                              <http://www.geneontology.org/formats/oboInOwl#id> "CHEBI:233324" ;
                                              <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/2_STAR> ;
                                              rdfs:label "Darovasertib" .


