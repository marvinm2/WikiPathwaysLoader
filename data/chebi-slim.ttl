                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_140345> ,
                                                              <http://purl.obolibrary.org/obo/CHEBI_15904> ,
                                                              <http://purl.obolibrary.org/obo/CHEBI_61498> ;
                                              <http://purl.obolibrary.org/obo/IAO_0000115> "An epoxy fatty acid that is (7<i>E</i>,9<i>E</i>,11<i>Z</i>,14<i>Z</i>,16<i>E</i>)-icosa-7,9,11,14,16-pentaenoic acid carrying an epoxy group at position 5<i>S</i> and a hydroxy group at position 18<i>S</i>. It is an intermediate in resolvin E1 biosynthesis." ;
                                              <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chebi_ontology" ;
                                              <http://www.geneontology.org/formats/oboInOwl#id> "CHEBI:138490" ;
