###  http://purl.obolibrary.org/obo/CHEBI_49375
<http://purl.obolibrary.org/obo/CHEBI_49375> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_29347> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_36683> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_38338> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_38418> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_46848> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_46851> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_50860> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_50995> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_50996> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_62733> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An aminopyrimidine that is 2-methylpyrimidine which is substituted at position 4 by the primary amino group of 2-amino-1,3-thiazole-5-carboxylic acid and at position 6 by a 4-(2-hydroxyethyl)piperazin-1-yl group, and in which the carboxylic acid group has been formally condensed with 2-chloro-6-methylaniline to afford the corresponding amide. A multi-targeted kinase inhibitor, it is used, particularly as the monohydrate, for the treatment of chronic, accelerated, or myeloid or lymphoid blast phase chronic myeloid leukemia. Note that the name 'dasatinib' is used to refer to the monohydrate (USAN) as well as to anhydrous dasatinib (INN)." ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> "CHEBI:38943" ,
                                                                                                             "CHEBI:49372" ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chebi_ontology" ;
                                             <http://www.geneontology.org/formats/oboInOwl#id> "CHEBI:49375" ;
                                             <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/3_STAR> ;
                                             rdfs:label "dasatinib (anhydrous)" .


