###  http://purl.obolibrary.org/obo/CHEBI_32020
<http://purl.obolibrary.org/obo/CHEBI_32020> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_26513> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_35972> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_50860> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_51454> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_83575> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_87635> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A dihydroxy monocarboxylic acid that is (6<i>E</i>)-7-[2-cyclopropyl-4-(4-fluorophenyl)quinolin-3-yl]hept-6-enoic acid in which the two hydroxy groups are located at positions 3 and 5 (the 3<i>R</i>,5<i>S</i>-stereoisomer). Used as its calcium salt for treatment of hypercholesterolemia (elevated levels of cholesterol in the blood) on patients unable to sufficiently lower their cholesterol levels by diet and exercise." ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chebi_ontology" ;
                                             <http://www.geneontology.org/formats/oboInOwl#id> "CHEBI:32020" ;
                                             <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/3_STAR> ;
                                             rdfs:label "pitavastatin" .


###  http://purl.obolibrary.org/obo/CHEBI_3207
<http://purl.obolibrary.org/obo/CHEBI_3207> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_139590> ,
                                                            <http://purl.obolibrary.org/obo/CHEBI_24261> ,
