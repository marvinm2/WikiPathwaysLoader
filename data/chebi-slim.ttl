<http://purl.obolibrary.org/obo/CHEBI_138392> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_15904> ,
                                                              <http://purl.obolibrary.org/obo/CHEBI_189832> ,
                                                              <http://purl.obolibrary.org/obo/CHEBI_23899> ;
                                              <http://purl.obolibrary.org/obo/IAO_0000115> "A hydroperoxy polyunsaturated fatty acid that is any icosapentaenoic fatty acid carrying a single hydroperoxy substituent." ;
                                              <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chebi_ontology" ;
                                              <http://www.geneontology.org/formats/oboInOwl#id> "CHEBI:138392" ;
