###  http://purl.obolibrary.org/obo/CHEBI_27295
<http://purl.obolibrary.org/obo/CHEBI_27295> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_35307> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An epoxycarotenol that is 5,5',6,6'-tetrahydro-5,6:5',6'-diepoxy-β,β-carotene substituted by hydroxy groups at positions 3 and 3'. It is the naturally occurring xanthophyll pigment found in a variety of plants." ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chebi_ontology" ;
                                             <http://www.geneontology.org/formats/oboInOwl#id> "CHEBI:27295" ;
