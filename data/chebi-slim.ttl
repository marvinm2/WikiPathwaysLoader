###  http://purl.obolibrary.org/obo/CHEBI_38561
<http://purl.obolibrary.org/obo/CHEBI_38561> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_50860> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_60911> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_87635> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A racemate comprising equimolar amounts of (3<i>R</i>,5<i>S</i>)- and (3<i>S</i>,5<i>R</i>)-fluvastatin. An HMG-CoA reductase inhibitor, it is used (often as the corresponding sodium salt) to reduce triglycerides and LDL-cholesterol, and increase HDL-chloesterol, in the treatment of hyperlipidaemia." ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chebi_ontology" ;
                                             <http://www.geneontology.org/formats/oboInOwl#id> "CHEBI:38561" ;
                                             <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/3_STAR> ;
                                             rdfs:label "fluvastatin" .


###  http://purl.obolibrary.org/obo/CHEBI_38562
<http://purl.obolibrary.org/obo/CHEBI_38562> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24828> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_35972> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_37143> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A dihydroxy monocarboxylic acid that is <em>N</em>-isopropylindole which is substituted at position 3 by a <em>p</em>-fluorophenyl group and at position 2 by a 6-carboxy-3,5-dihydroxyhex-1-en-1-yl group. It has four possible diastereoisomers." ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chebi_ontology" ;
                                             <http://www.geneontology.org/formats/oboInOwl#id> "CHEBI:38562" ;
                                             <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/3_STAR> ;
                                             rdfs:label "(6E)-7-[3-(4-fluorophenyl)-1-(propan-2-yl)-1H-indol-2-yl]-3,5-dihydroxyhept-6-enoic acid" .


###  http://purl.obolibrary.org/obo/CHEBI_38565
<http://purl.obolibrary.org/obo/CHEBI_38565> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_38562> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_87635> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A (6<i>E</i>)-7-[3-(4-fluorophenyl)-1-(propan-2-yl)-1<em>H</em>-indol-2-yl]-3,5-dihydroxyhept-6-enoic acid diastereoisomer in which the stereocentres β- and δ- to the carboxy group have <i>R</i> and <i>S</i> configuration, respectively. The drug fluvastatin is an equimolar mixture of this compound and its enantiomer." ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chebi_ontology" ;
                                             <http://www.geneontology.org/formats/oboInOwl#id> "CHEBI:38565" ;
