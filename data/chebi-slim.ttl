###  http://purl.obolibrary.org/obo/CHEBI_7476
<http://purl.obolibrary.org/obo/CHEBI_7476> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_25384> ,
                                                            <http://purl.obolibrary.org/obo/CHEBI_25477> ,
                                                            <http://purl.obolibrary.org/obo/CHEBI_48851> ,
                                                            <http://purl.obolibrary.org/obo/CHEBI_50860> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A methoxynaphthalene that is 2-methoxynaphthalene substituted by a carboxy ethyl group at position 6. Naproxen is a non-steroidal anti-inflammatory drug commonly used for the reduction of pain, fever, inflammation  and stiffness caused by conditions such as osteoarthritis, kidney stones, rheumatoid arthritis, psoriatic arthritis, gout, ankylosing spondylitis, menstrual cramps, tendinitis, bursitis, and for the treatment of primary dysmenorrhea. It works by inhibiting both the COX-1 and COX-2 enzymes." ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> "CHEBI:603695" ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chebi_ontology" ;
                                            <http://www.geneontology.org/formats/oboInOwl#id> "CHEBI:7476" ;
                                            <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/3_STAR> ;
                                            rdfs:label "naproxen" .


