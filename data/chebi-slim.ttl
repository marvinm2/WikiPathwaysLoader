                                             <http://www.geneontology.org/formats/oboInOwl#id> "CHEBI:35475" ;
                                             <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/3_STAR> ;
                                             rdfs:label "non-steroidal anti-inflammatory drug" .


