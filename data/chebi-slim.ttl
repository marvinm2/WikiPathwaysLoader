###  http://purl.obolibrary.org/obo/CHEBI_46345
<http://purl.obolibrary.org/obo/CHEBI_46345> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_17792> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_37143> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_39447> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_50860> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_67142> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A nucleobase analogue that is uracil in which the hydrogen at position 5 is replaced by fluorine. It is an antineoplastic agent which acts as an antimetabolite - following conversion to the active deoxynucleotide, it inhibits DNA synthesis (by blocking the conversion of deoxyuridylic acid to thymidylic acid by the cellular enzyme thymidylate synthetase) and so slows tumour growth." ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> "CHEBI:2054" ,
                                                                                                             "CHEBI:46343" ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chebi_ontology" ;
                                             <http://www.geneontology.org/formats/oboInOwl#id> "CHEBI:46345" ;
                                             <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/3_STAR> ;
                                             rdfs:label "5-fluorouracil" .


