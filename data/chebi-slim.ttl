###  http://purl.obolibrary.org/obo/CHEBI_78543
<http://purl.obolibrary.org/obo/CHEBI_78543> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_22702> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_46920> ,
