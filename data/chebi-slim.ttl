                                                             <http://purl.obolibrary.org/obo/CHEBI_36963> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "Any member of the group of eight water-soluble vitamins originally thought to be a single compound (vitamin B) that play important roles in cell metabolism. The group comprises of vitamin B<small><sub>1</sub></small>, B<small><sub>2</sub></small>, B<small><sub>3</sub></small>, B<small><sub>5</sub></small>, B<small><sub>6</sub></small>, B<small><sub>7</sub></small>, B<small><sub>9</sub></small>, and B<small><sub>12</sub></small> (Around 20 other compounds were once thought to be B vitamins but are no longer classified as such)." ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chebi_ontology" ;
                                             <http://www.geneontology.org/formats/oboInOwl#id> "CHEBI:75769" ;
                                             <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/3_STAR> ;
                                             rdfs:label "B vitamin" .


