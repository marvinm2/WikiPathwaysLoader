                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_46761> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A dipeptide consisting of glycine having an <small>L</small>-cysteinyl attached to its α-amino group. It is an intermediate metabolite in glutathione metabolism." ;
